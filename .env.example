# ──────────────────────────────────────────────────────────────────────────────
# Team Yuva — environment template.  Copy to ".env.local" and fill in real values.
# (".env.local" is gitignored; this example file is safe to commit.)
#
# Full walkthrough: see SUPABASE_SETUP.md
# ──────────────────────────────────────────────────────────────────────────────

# 1) REQUIRED — project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2) REQUIRED — the client ("publishable") key. Set AT LEAST ONE of the next two.
#    New-style publishable key -> starts with "sb_publishable_"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
#    Legacy anon key -> long JWT starting with "eyJ" (used as a fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# 3) OPTIONAL — where the sign-up confirmation e-mail returns during local dev.
#    Must also be listed in Supabase -> Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# 4) OPTIONAL — lets a coach create already-confirmed client accounts from /admin/users
#    (Supabase -> Project Settings -> API -> service_role / secret key). Without it the
#    app falls back to "invite people from Supabase -> Authentication -> Users -> Add user".
#    SERVER-ONLY: never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
